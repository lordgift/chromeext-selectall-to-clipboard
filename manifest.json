{
  "manifest_version": 3,
  "name": "Select n Copy for TikTok Seller | LordGift",
  "description": "Easier copy whole page of TikTok's order detail then extract data and submit to Google Form immediately.",
  "version": "2.1",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "select-n-copy-vibrant.png"
  },
  "icons": {
    "16": "select-n-copy-vibrant.png",
    "32": "select-n-copy-vibrant.png",
    "48": "select-n-copy-vibrant.png",
    "128": "select-n-copy-vibrant.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "clipboardRead",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://seller-th.tiktok.com/order/detail*",
    "https://docs.google.com/forms/d/e/*",
    "https://api.apify.com/v2/acts/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "contentScript.js"
      ],
      "matches": [
        "https://seller-th.tiktok.com/order/detail*"
      ]
    }
  ]
}