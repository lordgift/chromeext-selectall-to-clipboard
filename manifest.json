{
  "manifest_version": 3,
  "name": "Select n Copy | LordGift",
  "description": "Easier select all in page then copy into.",
  "version": "1.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "Gemini_Generated_Image_jin6lnjin6lnjin6.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "https://seller-th.tiktok.com/order/detail*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "contentScript.js"
      ],
      "matches": [
        "https://seller-th.tiktok.com/order/detail*"
      ]
    }
  ]
}